<?xml version="1.0" encoding="utf-8"?>
<!-- Join For More @PRIVATE_SRC_FILES -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Top Header & Logo -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Safe"
                    android:textColor="#E5A93C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ztrax_logo"
                    android:contentDescription="ZTRAX Emblem" />

            </LinearLayout>

            <!-- Login Card Container -->
            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/headerLayout"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_ztrax_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="ENTER LICENSE CREDENTIALS"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Outlined Gold Input with Cutout Label -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Inner outlined box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ztrax_input_gold"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_key_gold"
                            android:contentDescription="Key Icon" />

                        <EditText
                            android:id="@+id/userkey"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint=""
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/paste"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle Password / Paste"
                            android:padding="2dp"
                            android:src="@drawable/ic_eye_gold" />

                    </LinearLayout>

                    <!-- Floating Gold Label cutting the top border -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="#121316"
                        android:paddingHorizontal="6dp"
                        android:text="License Key"
                        android:textColor="#F5C518"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Login Button -->
                <Button
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_ztrax_btn_login"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="LOGIN"
                    android:textColor="#F5C518"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Get Key Link -->
                <TextView
                    android:id="@+id/GetKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:padding="6dp"
                    android:text="GET LICENSE KEY"
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:id="@+id/footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/loginCard"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="Copyright © 2026 - PRIVATE_SRC_FILES\n™"
                android:textColor="#444444"
                android:textSize="11sp" />

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>