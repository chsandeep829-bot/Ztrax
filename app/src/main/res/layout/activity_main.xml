<?xml version="1.0" encoding="utf-8"?>
<!-- Join For More @PRIVATE_SRC_FILES -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Top Header -->
            <TextView
                android:id="@+id/mainHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Main Game Card (Image 2 Match) -->
            <LinearLayout
                android:id="@+id/gameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ztrax_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Game Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <!-- BGMI Icon -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="BGMI Icon"
                            android:scaleType="centerCrop"
                            android:src="@drawable/india" />

                    </androidx.cardview.widget.CardView>

                    <!-- Title, Package, Status -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Battlegrounds India"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="com.pubg.imobile"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <!-- Status row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="Ready Check"
                                android:src="@drawable/ic_check_circle_gold" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="Ready to launch"
                                android:textColor="#E0E0E0"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Game Version on Single Line -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:text="v4.7.0"
                            android:textColor="#77777D"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Top-Right Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ztrax_badge_bgmi"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="BGMI"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Action Buttons Row (Launch / Copied) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Launch Button -->
                    <Button
                        android:id="@+id/installGame"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ztrax_btn_launch"
                        android:drawableStart="@drawable/ic_play_gold"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="14dp"
                        android:text="LAUNCH"
                        android:textColor="#F5C518"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Copied / Copy Button -->
                    <Button
                        android:id="@+id/uninstallGame"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ztrax_btn_copied"
                        android:drawableStart="@drawable/ic_copy_green"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="14dp"
                        android:text="COPIED"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>



        </LinearLayout>

    </ScrollView>

</RelativeLayout>